diff --git a/src/kernel/kstat.h b/src/kernel/kstat.h
new file mode 100644
index 0000000..715db81
--- /dev/null
+++ b/src/kernel/kstat.h
@@ -0,0 +1,69 @@
+// Diagnostic: per-kernel-call counts and wall time, dumped every 5 s by whichever
+// thread notices (Switch bring-up: tells where the guest spends its time).
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <set>
+#include <rex/diag_sample.h>
+#include <rex/logging.h>
+#include <rex/system/xthread.h>
+
+namespace rex::kernel::kstat {
+struct Entry { uint64_t calls = 0; double ms = 0; };
+inline std::mutex& Mu() { static std::mutex m; return m; }
+inline std::map<std::string, Entry>& Tab() { static std::map<std::string, Entry> t; return t; }
+struct Active { std::string key; std::chrono::steady_clock::time_point t0; };
+inline std::map<const void*, Active>& Act() { static std::map<const void*, Active> a; return a; }
+inline std::string MakeKey(const char* n) {
+  auto* t = rex::system::XThread::GetCurrentThread();
+  return fmt::format("{}@{:08X}/t{:X}", n, t ? uint32_t(t->thread_state()->context()->lr) : 0u, t ? t->handle() : 0u);
+}
+inline std::chrono::steady_clock::time_point& Last() {
+  static auto t = std::chrono::steady_clock::now();
+  return t;
+}
+struct Scope {
+  std::string name;
+  std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+  explicit Scope(const char* n) : name(MakeKey(n)) {
+    std::lock_guard<std::mutex> l(Mu());
+    Act()[this] = {name, t0};
+  }
+  ~Scope() {
+    auto now = std::chrono::steady_clock::now();
+    double ms = std::chrono::duration<double, std::milli>(now - t0).count();
+    std::lock_guard<std::mutex> l(Mu());
+    Act().erase(this);
+    auto& e = Tab()[name];
+    ++e.calls;
+    e.ms += ms;
+    if (now - Last() >= std::chrono::seconds(5)) {
+      Last() = now;
+      std::vector<std::pair<std::string, Entry>> v(Tab().begin(), Tab().end());
+      std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second.calls > b.second.calls; });
+      std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second.ms > b.second.ms; });
+      std::string s;
+      int n = 0;
+      for (auto& [k, x] : v) { if (++n > 14) break; s += fmt::format(" {}={}c/{:.0f}ms", k, x.calls, x.ms); }
+      REXKRNL_INFO("[kstat] top by time:{}", s);
+      std::string a;
+      for (auto& [p, ac] : Act()) {
+        double age = std::chrono::duration<double, std::milli>(now - ac.t0).count();
+        if (age > 1500) a += fmt::format(" {}={:.0f}ms", ac.key, age);
+      }
+      std::string w;
+      for (int i = 0; i < 64 && i < rex_diag::g_slots.n.load(); ++i)
+        w += fmt::format(" t{:X}={}", rex_diag::g_slots.h[i], rex_diag::g_slots.fn[i] ? rex_diag::g_slots.fn[i] : "?");
+      REXKRNL_INFO("[kstat] current guest function per thread:{}", w);
+      REXKRNL_INFO("[kstat] blocked >1.5s now:{}", a.empty() ? " (none)" : a);
+    }
+  }
+};
+}  // namespace rex::kernel::kstat
+#define KSTAT(name) ::rex::kernel::kstat::Scope _kstat_scope(name)
