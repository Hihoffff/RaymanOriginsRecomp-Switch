diff --git a/include/rex/diag_sample.h b/include/rex/diag_sample.h
new file mode 100644
index 0000000..8390fe5
--- /dev/null
+++ b/include/rex/diag_sample.h
@@ -0,0 +1,23 @@
+// Diagnostic (Switch bring-up): every guest function records its name in a
+// per-thread slot on entry; kstat.h dumps the slots, which shows where each
+// guest thread currently is (a poor man's sampling profiler).
+#pragma once
+#include <atomic>
+#include <cstdint>
+namespace rex_diag {
+uint32_t CurrentHandle();  // defined in xthread.cpp
+struct Slots {
+  const char* volatile fn[64];
+  uint32_t h[64];
+  std::atomic<int> n{0};
+};
+inline Slots g_slots;
+inline thread_local int t_slot = -1;
+inline void Mark(const char* f) {
+  if (t_slot < 0) {
+    t_slot = g_slots.n.fetch_add(1) % 64;
+    g_slots.h[t_slot] = CurrentHandle();
+  }
+  g_slots.fn[t_slot] = f;
+}
+}  // namespace rex_diag
