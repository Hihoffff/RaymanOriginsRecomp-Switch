     }
   } else {
-    REXSYS_WARN("Too few processor cores - scheduling will be wonky");
+    // Logged once: the guest re-pins threads thousands of times per second and
+    // a log line each time (over nxlink) throttles the whole process.
+    static std::atomic<bool> warned{false};
+    if (!warned.exchange(true)) {
+      REXSYS_WARN("Too few processor cores - scheduling will be wonky (logged once)");
+    }
   }
 }
 
