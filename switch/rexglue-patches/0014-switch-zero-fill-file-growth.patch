   return X_STATUS_SUCCESS;
 }
 
+// DIAG(save): log I/O on save files with a hash of the data.
+static bool SaveDiagPath(const std::string& p) {
+  return p.find("avegame") != std::string::npos || p.find("AVEGAME") != std::string::npos;
+}
+static uint64_t SaveDiagHash(const uint8_t* d, size_t n) {
+  uint64_t h = 1469598103934665603ull;
+  for (size_t i = 0; i < n; ++i) h = (h ^ d[i]) * 1099511628211ull;
+  return h;
+}
+
 X_STATUS XFile::Read(uint32_t buffer_guest_address, uint32_t buffer_length, uint64_t byte_offset,
                      uint32_t* out_bytes_read, uint32_t apc_context, bool notify_completion) {
   std::lock_guard<std::mutex> lock(file_lock_);
-  return ReadInternal(buffer_guest_address, buffer_length, byte_offset, out_bytes_read, apc_context,
-                      notify_completion);
+  const uint64_t pos_before = position_;
+  uint32_t local_read = 0;
+  if (!out_bytes_read) out_bytes_read = &local_read;
+  X_STATUS r = ReadInternal(buffer_guest_address, buffer_length, byte_offset, out_bytes_read,
+                            apc_context, notify_completion);
+  if (SaveDiagPath(path())) {
+    REXSYS_INFO("[save] read '{}' off={} pos={} len={} -> {:#x} got={} hash={:016X} buf={:08X}",
+                path(), (int64_t)byte_offset, pos_before, buffer_length, r, *out_bytes_read,
+                SaveDiagHash(memory()->TranslateVirtual<const uint8_t*>(buffer_guest_address),
+                             *out_bytes_read),
+                buffer_guest_address);
+  }
+  return r;
 }
 
 X_STATUS XFile::ReadInternal(uint32_t buffer_guest_address, uint32_t buffer_length,
@@ -269,6 +290,13 @@ X_STATUS XFile::Write(uint32_t buffer_guest_address, uint32_t buffer_length, uin
   if (XSUCCEEDED(result)) {
     position_ += bytes_written;
   }
+  if (SaveDiagPath(path())) {
+    REXSYS_INFO("[save] write '{}' off={} len={} -> {:#x} wrote={} hash={:016X} buf={:08X}",
+                path(), (int64_t)byte_offset, buffer_length, result, bytes_written,
+                SaveDiagHash(memory()->TranslateVirtual<const uint8_t*>(buffer_guest_address),
+                             buffer_length),
+                buffer_guest_address);
+  }
 
   XIOCompletion::IONotification notify;
   notify.apc_context = apc_context;
@@ -287,7 +315,9 @@ X_STATUS XFile::Write(uint32_t buffer_guest_address, uint32_t buffer_length, uin
 
 X_STATUS XFile::SetLength(size_t length) {
   std::lock_guard<std::mutex> lock(file_lock_);
-  return file_->SetLength(length);
+  X_STATUS r = file_->SetLength(length);
+  if (SaveDiagPath(path())) REXSYS_INFO("[save] setlength '{}' {} -> {:#x}", path(), length, r);
+  return r;
 }
 
