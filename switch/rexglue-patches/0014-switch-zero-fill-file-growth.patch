From: hihoffff <hihoffff@example.invalid>
Date: Fri, 13 Nov 2026 22:37:58 +0300
Subject: [PATCH] Switch: zero-fill file growth (Horizon FAT keeps stale
 clusters -> corrupted saves), [save] I/O log for save files

---
 src/core/filesystem_posix.cpp       | 34 +++++++++++++++++++++++++--
 src/core/libc_stubs_switch.cpp      | 21 ++++++++++++++++-
 src/kernel/xam/xam_content.cpp      |  4 ++++
 src/kernel/xboxkrnl/xboxkrnl_io.cpp |  7 ++++++
 src/system/xam/content_manager.cpp  |  3 +++
 src/system/xfile.cpp                | 36 ++++++++++++++++++++++++++---
 6 files changed, 99 insertions(+), 6 deletions(-)

diff --git a/src/core/filesystem_posix.cpp b/src/core/filesystem_posix.cpp
index 765d487..840ea1f 100644
--- a/src/core/filesystem_posix.cpp
+++ b/src/core/filesystem_posix.cpp
@@ -147,6 +147,36 @@ int64_t Tell(FILE* file) {
   return int64_t(rex_ftello64(file));
 }
 
+
+namespace {
+// Grows/shrinks a file like ftruncate, but guarantees that a grown tail reads
+// as zeros. Horizon's FAT driver does not zero-fill on fsFileSetSize: the new
+// clusters keep whatever was on the SD card, and games (Rayman Origins'
+// save slots) then read garbage where POSIX/Windows promise zeros.
+int TruncateZeroFill(int fd, int64_t length) {
+#if REX_PLATFORM_SWITCH
+  struct stat st;
+  const int64_t old_size = fstat(fd, &st) == 0 ? int64_t(st.st_size) : -1;
+  if (ftruncate(fd, length) != 0) return -1;
+  if (old_size < 0 || length <= old_size) return 0;
+  static const uint8_t kZeros[64 * 1024] = {};
+  const off_t saved = lseek(fd, 0, SEEK_CUR);
+  if (lseek(fd, old_size, SEEK_SET) < 0) return -1;
+  int64_t left = length - old_size;
+  while (left > 0) {
+    const size_t chunk = left > int64_t(sizeof(kZeros)) ? sizeof(kZeros) : size_t(left);
+    const ssize_t n = write(fd, kZeros, chunk);
+    if (n <= 0) return -1;
+    left -= n;
+  }
+  if (saved >= 0) lseek(fd, saved, SEEK_SET);
+  return 0;
+#else
+  return ftruncate(fd, length);
+#endif
+}
+}  // namespace
+
 bool TruncateStdioFile(FILE* file, uint64_t length) {
   if (fflush(file)) {
     return false;
@@ -155,7 +185,7 @@ bool TruncateStdioFile(FILE* file, uint64_t length) {
   if (position < 0) {
     return false;
   }
-  if (rex_ftruncate64(fileno(file), rex_off64_t(length))) {
+  if (TruncateZeroFill(fileno(file), int64_t(length))) {
     return false;
   }
   if (uint64_t(position) > length) {
@@ -219,7 +249,7 @@ class PosixFileHandle : public FileHandle {
     *out_bytes_written = static_cast<size_t>(out);
     return true;
   }
-  bool SetLength(size_t length) override { return ftruncate(handle_, length) >= 0 ? true : false; }
+  bool SetLength(size_t length) override { return TruncateZeroFill(handle_, int64_t(length)) >= 0; }
   void Flush() override { fsync(handle_); }
 
  private:
diff --git a/src/core/libc_stubs_switch.cpp b/src/core/libc_stubs_switch.cpp
index e31e6a9..56e8f64 100644
--- a/src/core/libc_stubs_switch.cpp
+++ b/src/core/libc_stubs_switch.cpp
@@ -93,7 +93,26 @@ ssize_t pread(int fd, void* buf, size_t count, off_t offset) {
 ssize_t pwrite(int fd, const void* buf, size_t count, off_t offset) {
   std::lock_guard<std::mutex> lock(g_positional_io_mutex);
   const off_t saved = lseek(fd, 0, SEEK_CUR);
-  if (saved < 0 || lseek(fd, offset, SEEK_SET) < 0) {
+  if (saved < 0) {
+    return -1;
+  }
+  // Writing past EOF leaves a gap; Horizon's FAT driver does not zero it
+  // (POSIX does), so fill it explicitly.
+  const off_t end = lseek(fd, 0, SEEK_END);
+  if (end >= 0 && offset > end) {
+    static const char kZeros[64 * 1024] = {};
+    off_t left = offset - end;
+    while (left > 0) {
+      const size_t chunk = left > off_t(sizeof(kZeros)) ? sizeof(kZeros) : size_t(left);
+      const ssize_t z = write(fd, kZeros, chunk);
+      if (z <= 0) {
+        lseek(fd, saved, SEEK_SET);
+        return -1;
+      }
+      left -= z;
+    }
+  }
+  if (lseek(fd, offset, SEEK_SET) < 0) {
     return -1;
   }
   const ssize_t n = write(fd, buf, count);
