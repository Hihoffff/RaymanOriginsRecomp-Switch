From 4d424fa3fece38b03523075772b04abeb5985ae3 Mon Sep 17 00:00:00 2001
From: hihoffff <hihoffff@example.invalid>
Date: Mon, 9 Nov 2026 22:04:31 +0300
Subject: [PATCH 2/6] InvalidFunctionTrap: guest stack scan

---
 src/system/function_dispatcher.cpp | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/system/function_dispatcher.cpp b/src/system/function_dispatcher.cpp
index 7fb663e..9ffa920 100644
--- a/src/system/function_dispatcher.cpp
+++ b/src/system/function_dispatcher.cpp
@@ -13,6 +13,9 @@
  *              role as a function dispatch table rather than a CPU emulator.
  */
 
+#include <cstring>
+#include <string>
+
 #include <rex/assert.h>
 #include <rex/dbg.h>
 #include <rex/logging.h>
@@ -34,7 +37,23 @@ FunctionDispatcher* GetBoundFunctionDispatcher() {
 
 }  // namespace
 
-static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
+static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* base) {
+  // Diagnostic: scan the guest stack for words that look like code addresses
+  // (poor man's backtrace) and print them before the fatal message.
+  {
+    std::string hits;
+    int found = 0;
+    for (uint32_t i = 0; i < 1024 && found < 24; ++i) {
+      uint32_t raw;
+      std::memcpy(&raw, base + ctx.r1.u32 + 4 * i, sizeof(raw));
+      uint32_t v = __builtin_bswap32(raw);
+      if (v >= 0x82120000u && v <= 0x829849B4u && (v & 3) == 0) {
+        hits += fmt::format(" {:08X}@+{:X}", v, 4 * i);
+        ++found;
+      }
+    }
+    REXLOG_CRITICAL("guest stack scan (code-like words):{}", hits);
+  }
   REX_FATAL(
       "Call to invalid or unregistered function at guest address 0x{:08X} "
       "(lr=0x{:08X} r1=0x{:08X} r3=0x{:08X} r4=0x{:08X} ctr=0x{:08X})",
-- 
