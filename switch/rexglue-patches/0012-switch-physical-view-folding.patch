diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index ac6b056..bab4d09 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -124,6 +124,18 @@ class GraphicsSystem : public system::IGraphicsSystem {
   RegisterFile register_file_;
   std::unique_ptr<CommandProcessor> command_processor_;
 
+#if REX_PLATFORM_SWITCH
+  // Horizon cannot trap guest loads/stores to the GPU register page (no
+  // resumable faults, no page protection), so plain guest accesses land in
+  // ordinary memory. A host "pump" thread forwards guest writes found there to
+  // WriteRegister and mirrors readable register values back (graphics_system.cpp).
+  void StartMmioPump();
+  uint32_t ReadRegisterQuiet(uint32_t r);  // ReadRegister by index, no logging
+  void StopMmioPump();
+  std::atomic<bool> mmio_pump_running_{false};
+  std::thread mmio_pump_thread_;
+#endif
+
   bool paused_ = false;
 
  private:
diff --git a/include/rex/system/xmemory.h b/include/rex/system/xmemory.h
index 0c39a42..fe98458 100644
--- a/include/rex/system/xmemory.h
+++ b/include/rex/system/xmemory.h
@@ -38,8 +38,14 @@ namespace rex::memory::detail {
 ///   - macOS arm64:    16KB granularity  -> offset
 ///   - macOS x86_64:    4KB granularity  -> no offset
 ///   - Linux (any):     4KB granularity  -> no offset (mmap handles it natively)
-constexpr u32 PhysicalHostOffset([[maybe_unused]] u32 guest_addr) noexcept {
-#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && defined(__aarch64__))
+constexpr int64_t PhysicalHostOffset([[maybe_unused]] u32 guest_addr) noexcept {
+#if REX_PLATFORM_SWITCH
+  // Must match REX_PHYS_HOST_OFFSET in the codegen pch template: the 0xC0/0xE0
+  // physical views are folded onto the 0xA0 view (no page aliasing on Horizon).
+  return (guest_addr >= 0xE0000000u)   ? -0x3FFFF000ll
+         : (guest_addr >= 0xC0000000u) ? -0x20000000ll
+                                       : 0;
+#elif REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && defined(__aarch64__))
   return (guest_addr >= 0xE0000000u) ? 0x1000u : 0u;
 #else
   return 0u;
@@ -385,6 +391,12 @@ class Memory {
   // Note that the contents at the specified host address are big-endian.
   template <typename T = uint8_t*>
   inline T TranslateVirtual(uint32_t guest_address) const {
+#if REX_PLATFORM_SWITCH
+    if (guest_address >= 0xC0000000u) {
+      return reinterpret_cast<T>(virtual_membase_ + guest_address +
+                                 detail::PhysicalHostOffset(guest_address));
+    }
+#endif
     uint8_t* host_address = virtual_membase_ + guest_address;
     const auto heap = LookupHeap(guest_address);
     if (heap) {
