+#if REX_PLATFORM_SWITCH
+namespace {
+constexpr uint32_t kMmioBase = 0x7FC80000;
+constexpr uint32_t kMmioWords = 0x10000 / 4;  // 64 KB register window
+}  // namespace
+
+void GraphicsSystem::StartMmioPump() {
+  auto* page = reinterpret_cast<volatile uint32_t*>(memory_->TranslateVirtual(kMmioBase));
+  // Seed the page with what ReadRegister would return (big-endian, as the
+  // guest reads it), and remember it as the shadow to detect guest writes.
+  auto shadow = std::make_shared<std::vector<uint32_t>>(kMmioWords);
+  for (uint32_t i = 0; i < kMmioWords; ++i) {
+    uint32_t v = (i < RegisterFile::kRegisterCount) ? ReadRegisterQuiet(i) : 0;
+    page[i] = __builtin_bswap32(v);
+    (*shadow)[i] = page[i];
+  }
+  REXGPU_INFO("mmio-pump: started (Switch has no MMIO traps; polling 0x{:08X}..+64KB)", kMmioBase);
+  mmio_pump_running_ = true;
+  mmio_pump_thread_ = std::thread([this, page, shadow]() {
+    auto& sh = *shadow;
+    uint64_t writes = 0;
+    int logged = 0;
+    auto last_report = std::chrono::steady_clock::now();
+    while (mmio_pump_running_.load(std::memory_order_relaxed)) {
+      // 1) Guest writes: any word that differs from what we last stored/saw.
+      for (uint32_t i = 0; i < kMmioWords; ++i) {
+        uint32_t raw = page[i];
+        if (raw != sh[i]) {
+          sh[i] = raw;
+          uint32_t value = __builtin_bswap32(raw);
+          if (logged < 48) {
+            ++logged;
+            REXGPU_INFO("mmio-pump: guest write reg {:04X} = {:08X}", i, value);
+          }
+          ++writes;
+          WriteRegister(kMmioBase + i * 4, value);
+        }
+      }
+      // 2) Guest reads: mirror registers the GPU side changes (scratch, status...).
+      for (uint32_t i = 0; i < kMmioWords && i < RegisterFile::kRegisterCount; ++i) {
+        uint32_t want = __builtin_bswap32(ReadRegisterQuiet(i));
+        if (want != sh[i]) {
+          page[i] = want;
+          sh[i] = want;
+        }
+      }
+      auto now = std::chrono::steady_clock::now();
+      if (now - last_report >= std::chrono::seconds(10)) {
+        last_report = now;
+        REXGPU_INFO("mmio-pump: {} guest register writes forwarded so far", writes);
+      }
+      std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+  });
+}
+
+uint32_t GraphicsSystem::ReadRegisterQuiet(uint32_t r) {
+  switch (r) {
+    case 0x0F00:
+    case 0x0F01:
+    case 0x194C:
+    case 0x1951:
+    case 0x1961:
+      return ReadRegister(kMmioBase + r * 4);
+    default:
+      return register_file_.values[r];
+  }
+}
+
+void GraphicsSystem::StopMmioPump() {
+  mmio_pump_running_ = false;
+  if (mmio_pump_thread_.joinable()) mmio_pump_thread_.join();
+}
+#endif  // REX_PLATFORM_SWITCH
