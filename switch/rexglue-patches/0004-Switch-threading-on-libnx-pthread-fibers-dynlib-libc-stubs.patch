+/**
+ * @file        core/libc_stubs_switch.cpp
+ * @brief       Nintendo Switch: libc functions that newlib/libnx do not provide
+ *
+ * The core calls these in process-launch, user-folder and positional-I/O
+ * paths that either are not reachable on Horizon or can be emulated.
+ */
+
+#include <rex/platform.h>
+
+static_assert(REX_PLATFORM_SWITCH, "This file is Nintendo Switch-only");
+
+#include <errno.h>
+#include <pwd.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <mutex>
+
+extern "C" {
+
+int execvp(const char* /*file*/, char* const /*argv*/[]) {
+  errno = ENOSYS;
+  return -1;
+}
+
+pid_t waitpid(pid_t /*pid*/, int* /*status*/, int /*options*/) {
+  errno = ECHILD;
+  return -1;
+}
+
+uid_t getuid(void) {
+  return 0;
+}
+
+int getpwuid_r(uid_t /*uid*/, struct passwd* /*pwd*/, char* /*buf*/, size_t /*buflen*/,
+               struct passwd** result) {
+  *result = nullptr;
+  return ENOENT;
+}
+
+// pread/pwrite are emulated with lseek+read/write under a lock. They move the
+// shared file offset, so callers must not mix them with plain read/write on
+// the same descriptor from several threads.
+static std::mutex g_positional_io_mutex;
+
+ssize_t pread(int fd, void* buf, size_t count, off_t offset) {
+  std::lock_guard<std::mutex> lock(g_positional_io_mutex);
+  const off_t saved = lseek(fd, 0, SEEK_CUR);
+  if (saved < 0 || lseek(fd, offset, SEEK_SET) < 0) {
+    return -1;
+  }
+  const ssize_t n = read(fd, buf, count);
+  lseek(fd, saved, SEEK_SET);
+  return n;
+}
+
+ssize_t pwrite(int fd, const void* buf, size_t count, off_t offset) {
+  std::lock_guard<std::mutex> lock(g_positional_io_mutex);
+  const off_t saved = lseek(fd, 0, SEEK_CUR);
+  if (saved < 0 || lseek(fd, offset, SEEK_SET) < 0) {
+    return -1;
+  }
+  const ssize_t n = write(fd, buf, count);
+  lseek(fd, saved, SEEK_SET);
+  return n;
+}
+
+}  // extern "C"
