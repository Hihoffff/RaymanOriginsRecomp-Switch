Date: Mon, 9 Nov 2026 23:39:44 +0300
Subject: [PATCH] Switch: silent audio driver (NopAudioDriver), kernel call
 tracing hooks (off by default)

---
 src/audio/nop/nop_audio_system.cpp         | 60 ++++++++++++++++++++--
 src/kernel/xboxkrnl/xboxkrnl_ob.cpp        |  5 ++
 src/kernel/xboxkrnl/xboxkrnl_threading.cpp | 38 ++++++++++++++
 3 files changed, 98 insertions(+), 5 deletions(-)

diff --git a/src/audio/nop/nop_audio_system.cpp b/src/audio/nop/nop_audio_system.cpp
index e479311..e9995fd 100644
--- a/src/audio/nop/nop_audio_system.cpp
+++ b/src/audio/nop/nop_audio_system.cpp
@@ -9,11 +9,58 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+#include <rex/audio/audio_driver.h>
 #include <rex/audio/flags.h>
 #include <rex/audio/nop/nop_audio_system.h>
+#include <rex/logging.h>
 
 namespace rex::audio::nop {
 
+// Silent driver: accepts the guest's audio frames, discards them and releases
+// the guest semaphore at the real-time frame rate (256 samples @ 48 kHz), so
+// the guest audio render thread keeps running without any output device.
+class NopAudioDriver : public AudioDriver {
+ public:
+  NopAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore) {
+    worker_ = std::thread([this] {
+      auto next = std::chrono::steady_clock::now();
+      while (!stop_.load()) {
+        next += std::chrono::microseconds(5333);
+        std::this_thread::sleep_until(next);
+        if (pending_.load() > 0) {
+          pending_.fetch_sub(1);
+          semaphore_->Release(1, nullptr);
+        }
+      }
+    });
+  }
+  ~NopAudioDriver() override { Shutdown(); }
+
+  void SubmitFrame(uint32_t /*samples_ptr*/) override {
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true)) {
+      REXAPU_INFO("nop-audio: first frame submitted");
+    }
+    pending_.fetch_add(1);
+  }
+
+  void Shutdown() {
+    stop_.store(true);
+    if (worker_.joinable()) worker_.join();
+  }
+
+ private:
+  rex::thread::Semaphore* semaphore_;
+  std::atomic<bool> stop_{false};
+  std::atomic<int> pending_{0};
+  std::thread worker_;
+};
+
 std::unique_ptr<AudioSystem> NopAudioSystem::Create(
     runtime::FunctionDispatcher* function_dispatcher) {
   return std::make_unique<NopAudioSystem>(function_dispatcher);
@@ -24,14 +71,17 @@ NopAudioSystem::NopAudioSystem(runtime::FunctionDispatcher* function_dispatcher)
 
 NopAudioSystem::~NopAudioSystem() = default;
 
-X_STATUS NopAudioSystem::CreateDriver(size_t /*index*/, rex::thread::Semaphore* /*semaphore*/,
-                                      AudioDriver** /*out_driver*/) {
-  return X_STATUS_NOT_IMPLEMENTED;
+X_STATUS NopAudioSystem::CreateDriver(size_t /*index*/, rex::thread::Semaphore* semaphore,
+                                      AudioDriver** out_driver) {
+  REXAPU_INFO("nop-audio: creating silent driver");
+  *out_driver = new NopAudioDriver(memory_, semaphore);
+  return X_STATUS_SUCCESS;
 }
 
 void NopAudioSystem::DestroyDriver(AudioDriver* driver) {
-  (void)driver;
-  assert_always();
+  auto* d = dynamic_cast<NopAudioDriver*>(driver);
+  if (d) d->Shutdown();
+  delete driver;
 }
 
 }  // namespace rex::audio::nop
