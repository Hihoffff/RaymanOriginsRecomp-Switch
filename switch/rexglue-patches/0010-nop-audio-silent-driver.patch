 #include <algorithm>
 #include <atomic>
 #include <chrono>
@@ -40,6 +41,20 @@
 #include <rex/thread/mutex.h>
 
 namespace rex::kernel::xboxkrnl {
+std::atomic<bool> g_kdiag{false};
+static void KDiagStack(rex::system::XThread* t) {
+  auto* c = t->thread_state()->context();
+  auto* mem = REX_KERNEL_MEMORY();
+  uint32_t r1 = uint32_t(c->r1.u64);
+  std::string out;
+  for (uint32_t i = 0; i < 1024; ++i) {
+    uint32_t v = rex::memory::load_and_swap<uint32_t>(mem->TranslateVirtual(r1 + 4 * i));
+    if (v >= 0x82120000 && v <= 0x829849B4 && (v & 3) == 0) out += fmt::format(" {:08X}@+{:X}", v, 4 * i);
+  }
+  REXKRNL_INFO("[kcall] stack scan (r1={:08X}):{}", r1, out);
+}
+#define KDIAG(name) do { if (g_kdiag.load()) { auto* _t = rex::system::XThread::GetCurrentThread(); REXKRNL_INFO("[kcall] {} thread={:08X} lr={:08X}", name, _t ? _t->handle() : 0u, _t ? uint32_t(_t->thread_state()->context()->lr) : 0u); if (_t && uint32_t(_t->thread_state()->context()->lr) == 0x825DE728) KDiagStack(_t); } } while (0)
+
 using namespace rex::system;
 using rex::runtime::current_ppc_context;
 
@@ -130,6 +145,7 @@ u32 ExCreateThread_entry(mapped_u32 handle_ptr, u32 stack_size, mapped_u32 threa
         w += fmt::format(" {:08X}", memory::load_and_swap<uint32_t>(p + 4 * i));
       }
     }
+    if (false) { g_kdiag.store(true); }
     REXKRNL_INFO(
         "[thread-diag] ExCreateThread start={:08X} context={:08X} flags={:X} stack={:X} words:{}",
         start_address.guest_address(), start_context.guest_address(), (uint32_t)creation_flags,
@@ -183,6 +199,7 @@ u32 ExCreateThread_entry(mapped_u32 handle_ptr, u32 stack_size, mapped_u32 threa
 }
 
 u32 ExTerminateThread_entry(u32 exit_code) {
