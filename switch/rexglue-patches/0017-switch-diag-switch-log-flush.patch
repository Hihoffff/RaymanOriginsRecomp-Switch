     REXKRNL_INFO("[save] NtCreateFile '{}' access={:#x} disp={:#x} opts={:#x} -> {:#x} action={} "
                  "handle={:#x}",
@@ -560,7 +561,7 @@ u32 NtQueryFullAttributesFile_entry(ppc_ptr_t<X_OBJECT_ATTRIBUTES> obj_attribs,
     const double ms =
         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - diag_t0).count();
     static std::atomic<int> logged{0};
-    if (ms > 5.0 && logged.fetch_add(1) < 30) {
+    if (REX_DIAG_ENABLED && ms > 5.0 && logged.fetch_add(1) < 30) {
       REXKRNL_INFO("[fsdiag] NtQueryFullAttributesFile '{}' {} in {:.1f} ms", target_path,
                    entry ? "found" : "MISSING", ms);
     }
