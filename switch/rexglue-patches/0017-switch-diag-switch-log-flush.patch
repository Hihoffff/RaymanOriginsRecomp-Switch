From f44baa50b6d0ba6bc4464a8f286daab8c6068f7b Mon Sep 17 00:00:00 2001
From: hihoffff <hihoffff@example.invalid>
Date: Sat, 14 Nov 2026 10:48:00 +0300
Subject: [PATCH] Switch: diagnostics behind REX_SWITCH_DIAG (rex/diag.h):
 [save]/[fsdiag]/[cpu]/gpu-cp/[perf-guest] compiled out when off; info lines
 not flushed per line on Switch; crash.log appended

---
 include/rex/diag.h                    | 11 +++++++++++
 include/rex/logging/types.h           |  6 ++++++
 src/core/exception_handler_switch.cpp |  3 ++-
 src/graphics/command_processor.cpp    |  7 ++++---
 src/graphics/null/null_gpu_switch.cpp |  2 ++
 src/kernel/kstat.h                    |  3 ++-
 src/kernel/xam/xam_content.cpp        |  3 ++-
 src/kernel/xboxkrnl/xboxkrnl_io.cpp   |  5 +++--
 src/system/xam/content_manager.cpp    |  5 +++--
 src/system/xfile.cpp                  |  7 ++++---
 10 files changed, 39 insertions(+), 13 deletions(-)
 create mode 100644 include/rex/diag.h

diff --git a/include/rex/diag.h b/include/rex/diag.h
new file mode 100644
index 0000000..694da3f
--- /dev/null
+++ b/include/rex/diag.h
@@ -0,0 +1,11 @@
+// Switch bring-up diagnostics switch. Builds pass -DREX_SWITCH_DIAG=1 (CMake
+// option RAYMAN_SWITCH_DIAG) to get the extra logging ([save], [fsdiag],
+// [cpu], [perf-guest], gpu-cp ...); without it every diagnostic branch is a
+// compile-time `if (0)` and is dropped. Game logic never depends on it.
+#pragma once
+
+#if defined(REX_SWITCH_DIAG) && REX_SWITCH_DIAG
+#define REX_DIAG_ENABLED 1
+#else
+#define REX_DIAG_ENABLED 0
+#endif
diff --git a/include/rex/logging/types.h b/include/rex/logging/types.h
index 984e28a..ec22193 100644
--- a/include/rex/logging/types.h
+++ b/include/rex/logging/types.h
@@ -80,7 +80,13 @@ struct LogConfig {
   std::string file_pattern = "[%Y-%m-%d %H:%M:%S.%e] [%l] [%n] [t%t] %v";
 
   /** Messages at or above this level trigger an immediate flush. */
+#if defined(__SWITCH__)
+  // SD card: flushing every info line costs frames; the host flushes stdout
+  // periodically, warnings and errors still go out at once.
+  spdlog::level::level_enum flush_level = spdlog::level::warn;
+#else
   spdlog::level::level_enum flush_level = spdlog::level::info;
+#endif
 
   /**
    * Per-category log level overrides.
diff --git a/src/core/exception_handler_switch.cpp b/src/core/exception_handler_switch.cpp
index dc45b29..5c0a834 100644
--- a/src/core/exception_handler_switch.cpp
+++ b/src/core/exception_handler_switch.cpp
@@ -74,7 +74,8 @@ void __libnx_exception_handler(ThreadExceptionDump* dump) {
   }
   if (n > (int)sizeof(buf)) n = sizeof(buf);
   write(2, buf, n);
-  int fd = open("sdmc:/switch/RaymanOriginsRecomp/crash.log", O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  // Appended: crashes from several sessions are kept.
+  int fd = open("sdmc:/switch/RaymanOriginsRecomp/crash.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
   if (fd >= 0) {
     write(fd, buf, n);
     close(fd);
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 969dd51..acfd11b 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -18,6 +18,7 @@
 
 #include <fmt/format.h>
 
+#include <rex/diag.h>
 #include <rex/cvar.h>
 #include <rex/dbg.h>
 #include <rex/perf/counter.h>
@@ -217,7 +218,7 @@ void CommandProcessor::WorkerThreadMain() {
       fn();
     }
 
-#if REX_PLATFORM_SWITCH
+#if REX_PLATFORM_SWITCH && REX_DIAG_ENABLED
     // DIAG: share of wall time the command processor is executing packets
     // (not idling for new commands), plus its own CPU time, every 5 s.
     static uint64_t diag_w0 = 0, diag_c0 = 0, diag_idle = 0;
@@ -240,7 +241,7 @@ void CommandProcessor::WorkerThreadMain() {
 #endif
     uint32_t write_ptr_index = write_ptr_index_.load();
     if (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index) {
-#if REX_PLATFORM_SWITCH
+#if REX_PLATFORM_SWITCH && REX_DIAG_ENABLED
       const uint64_t diag_idle_t0 = armGetSystemTick();
       struct IdleAcc {
         uint64_t t0;
@@ -1089,7 +1090,7 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
                                   std::chrono::steady_clock::now().time_since_epoch())
                                   .count();
           int64_t prev = last_log.load();
-          if (now - prev >= 5 && last_log.compare_exchange_strong(prev, now)) {
+          if (REX_DIAG_ENABLED && now - prev >= 5 && last_log.compare_exchange_strong(prev, now)) {
             REXGPU_INFO("[perf-guest] WAIT_REG_MEM: {} waits, {} polls in 5 s", waits.exchange(0),
                         sleeps.exchange(0));
           }
diff --git a/src/graphics/null/null_gpu_switch.cpp b/src/graphics/null/null_gpu_switch.cpp
index de25c8a..71f1213 100644
--- a/src/graphics/null/null_gpu_switch.cpp
+++ b/src/graphics/null/null_gpu_switch.cpp
@@ -14,6 +14,7 @@
  * @license     BSD 3-Clause License (same as ReXGlue)
  */
 
+#include <rex/diag.h>
 #include <rex/graphics/null_gpu.h>
 
 #include <chrono>
@@ -36,6 +37,7 @@ class SwitchNullCommandProcessor : public CommandProcessor {
 
   // Speed measurement for hardware runs: guest swaps, draws and copies per second.
   void Tick() {
+    if (!REX_DIAG_ENABLED) return;
     ::rex::kernel::kstat::CpuReport();
     ::rex_diag::Sample();
     using clock = std::chrono::steady_clock;
diff --git a/src/kernel/kstat.h b/src/kernel/kstat.h
index 29a8b9a..8f0d498 100644
--- a/src/kernel/kstat.h
+++ b/src/kernel/kstat.h
@@ -10,6 +10,7 @@
 #include <vector>
 
 #include <set>
+#include <rex/diag.h>
 #include <rex/diag_sample.h>
 #include <rex/logging.h>
 #include <rex/system/xthread.h>
@@ -102,7 +103,7 @@ inline void CpuReport() {
 // Off by default (costly: string key + mutex per call). Build with -DREX_KSTAT=1 to enable.
 #if defined(REX_KSTAT) && REX_KSTAT
 #define KSTAT(name) ::rex::kernel::kstat::Scope _kstat_scope(name)
-#elif REX_PLATFORM_SWITCH
+#elif REX_PLATFORM_SWITCH && REX_DIAG_ENABLED
 #define KSTAT(name) ::rex::kernel::kstat::CpuReport()
 #else
 #define KSTAT(name) ((void)0)
