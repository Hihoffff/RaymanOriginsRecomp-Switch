From 932162209d4951c3ed51c4e53b2e32155a75be34 Mon Sep 17 00:00:00 2001
From: hihoffff <hihoffff@example.invalid>
Date: Fri, 13 Nov 2026 23:24:25 +0300
Subject: [PATCH] Switch: guest threads may run on all 3 application cores
 (affinity mask 0x7, round-robin ideal core); WAIT_REG_MEM polls every 50 us
 instead of >=1 ms sleeps, with counters

---
 src/core/threading_posix.cpp       | 18 ++++++++++++++++++
 src/graphics/command_processor.cpp | 25 +++++++++++++++++++++++++
 2 files changed, 43 insertions(+)

diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index 55d169c..9fe3194 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -7,6 +7,9 @@
  */
 
 #include <rex/platform.h>
+#if REX_PLATFORM_SWITCH
+#include <switch.h>
+#endif
 #include <rex/thread.h>
 
 static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC || REX_PLATFORM_SWITCH, "This file is POSIX-only");
@@ -1479,6 +1482,21 @@ void* PosixCondition<Thread>::ThreadStartRoutine(void* parameter) {
   }
 #endif
   set_current_thread_name("");
+#if REX_PLATFORM_SWITCH
+  {
+    // Horizon threads are pinned to their ideal core (the process default,
+    // core 0) and never migrate unless the affinity mask allows it: every
+    // guest thread used to share core 0. Allow the three application cores
+    // and spread the ideal cores round-robin; idle cores then pick up work.
+    static std::atomic<uint32_t> next_core{1};
+    const int ideal = int(next_core.fetch_add(1) % 3);
+    Result rc = svcSetThreadCoreMask(threadGetCurHandle(), ideal, 0x7);
+    static std::atomic<int> logged{0};
+    if (logged.fetch_add(1) < 4) {
+      REXSYS_INFO("switch-threads: core mask 0x7, ideal core {} (rc=0x{:X})", ideal, rc);
+    }
+  }
+#endif
 
   auto start_data = static_cast<ThreadStartData*>(parameter);
   assert_not_null(start_data);
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 260c759..3260c00 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -23,6 +23,9 @@
 #include <rex/perf/counter.h>
 #include <rex/chrono/clock.h>
 #include <rex/graphics/command_processor.h>
+#include <chrono>
+#include <atomic>
+#include <thread>
 #include <rex/graphics/flags.h>
 #include <rex/graphics/graphics_system.h>
 #include <rex/graphics/pipeline/texture/info.h>
@@ -997,6 +1000,7 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
   bool is_memory = (wait_info & 0x10) != 0;
 
   bool matched = false;
+  [[maybe_unused]] bool first_poll = true;
   do {
     uint32_t value = 0;
     if (is_memory) {
@@ -1040,12 +1044,33 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
       // Wait.
       if (wait >= 0x100) {
         PrepareForWait();
+#if REX_PLATFORM_SWITCH
+        {
+          // A >=1 ms sleep per unmatched poll serialized the guest's CPU/GPU
+          // pipeline on Switch; poll every 50 us instead (3 cores available).
+          static std::atomic<uint64_t> waits{0}, sleeps{0};
+          static std::atomic<int64_t> last_log{0};
+          ++sleeps;
+          if (first_poll) ++waits;
+          first_poll = false;
+          std::this_thread::sleep_for(std::chrono::microseconds(50));
+          const int64_t now = std::chrono::duration_cast<std::chrono::seconds>(
+                                  std::chrono::steady_clock::now().time_since_epoch())
+                                  .count();
+          int64_t prev = last_log.load();
+          if (now - prev >= 5 && last_log.compare_exchange_strong(prev, now)) {
+            REXGPU_INFO("[perf-guest] WAIT_REG_MEM: {} waits, {} polls in 5 s", waits.exchange(0),
+                        sleeps.exchange(0));
+          }
+        }
+#else
         if (!REXCVAR_GET(vsync)) {
           // User wants it fast and dangerous.
           rex::thread::MaybeYield();
         } else {
           rex::thread::Sleep(std::chrono::milliseconds(wait / 0x100));
         }
+#endif
         rex::thread::SyncMemory();
         ReturnFromWait();
 
-- 
