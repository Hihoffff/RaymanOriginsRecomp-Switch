+// Platform factory used by WindowedApp.
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       std::string_view title,
+                                       uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<WindowSwitch>(app_context, title, desired_logical_width,
+                                        desired_logical_height);
+}
+
+WindowSwitch::WindowSwitch(WindowedAppContext& app_context, std::string_view title,
+                           uint32_t desired_logical_width,
+                           uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width, desired_logical_height) {}
+
+WindowSwitch::~WindowSwitch() { EnterDestructor(); }
+
+bool WindowSwitch::OpenImpl() {
+  // No native window on Horizon: the app owns the whole display. Report the
+  // desired size as actual and take focus immediately so the common Window
+  // code considers the window fully open.
+  WindowDestructionReceiver destruction_receiver(this);
+  OnActualSizeUpdate(GetDesiredLogicalWidth(), GetDesiredLogicalHeight(),
+                     destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return true;
+  }
+  OnFocusUpdate(true, destruction_receiver);
+  return true;
+}
+
+void WindowSwitch::RequestCloseImpl() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  // No native window to destroy between OnBeforeClose and OnAfterClose.
+  OnAfterClose();
+}
+
+std::unique_ptr<Surface> WindowSwitch::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  if (!(allowed_types & Surface::kTypeFlag_SwitchVi)) {
+    REXLOG_ERROR("Presenter requested surface types {:#x}, Switch supports only VI",
+                 allowed_types);
+    return nullptr;
+  }
+  return std::make_unique<SwitchSurface>();
+}
+
+void WindowSwitch::RequestPaintImpl() {
+  // No compositor to poke; the NVK presenter will drive frames itself.
+}
+
+}  // namespace rex::ui
