--- /dev/null
+++ b/include/rex/ui/surface_switch.h
@@ -0,0 +1,30 @@
+/**
+ * @file        ui/surface_switch.h
+ * @brief       Nintendo Switch surface (VI layer via NVK)
+ *
+ * Headless stand-in for bring-up: reports a fixed docked-mode size so
+ * surface queries succeed before the NVK/VI presenter exists.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+#include <rex/ui/surface.h>
+
+namespace rex::ui {
+
+class SwitchSurface final : public Surface {
+ public:
+  TypeIndex GetType() const override { return kTypeIndex_SwitchVi; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override {
+    // Docked-mode resolution; handheld is 1280x720, but presenting scales.
+    width_out = 1920;
+    height_out = 1080;
+    return true;
+  }
+};
+
+}  // namespace rex::ui
diff --git a/include/rex/ui/window_switch.h b/include/rex/ui/window_switch.h
new file mode 100644
index 0000000..70a1503
--- /dev/null
+++ b/include/rex/ui/window_switch.h
@@ -0,0 +1,34 @@
+/**
+ * @file        ui/window_switch.h
+ * @brief       Nintendo Switch implementation of the Window abstraction
+ *
+ * Horizon has no window manager: the "window" is the single fullscreen VI
+ * layer. This implementation is headless — it tracks state so the common
+ * Window/WindowedApp code runs, and producing pixels is left to the future
+ * NVK presenter.
+ */
+
+#pragma once
+
+#include <memory>
+#include <string_view>
+
+#include <rex/ui/window.h>
+
+namespace rex::ui {
+
+class WindowSwitch final : public Window {
+ public:
+  WindowSwitch(WindowedAppContext& app_context, std::string_view title,
+               uint32_t desired_logical_width, uint32_t desired_logical_height);
+  ~WindowSwitch() override;
+
+ protected:
+  bool OpenImpl() override;
+  void RequestCloseImpl() override;
+
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags allowed_types) override;
+  void RequestPaintImpl() override;
+};
+
+}  // namespace rex::ui
diff --git a/include/rex/ui/windowed_app_context_switch.h b/include/rex/ui/windowed_app_context_switch.h
new file mode 100644
index 0000000..2f44750
--- /dev/null
+++ b/include/rex/ui/windowed_app_context_switch.h
@@ -0,0 +1,35 @@
+/**
+ * @file        ui/windowed_app_context_switch.h
+ * @brief       Nintendo Switch implementation of the windowed app UI loop context
+ *
+ * Horizon has no OS message loop for apps, so the context runs its own loop
+ * on a condition variable: producers wake it via NotifyUILoopOfPendingFunctions.
+ */
+
+#pragma once
+
+#include <condition_variable>
+#include <mutex>
+
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::ui {
+
+class SwitchWindowedAppContext final : public WindowedAppContext {
+ public:
+  SwitchWindowedAppContext() = default;
+  ~SwitchWindowedAppContext() override;
+
+  bool Initialize() { return true; }
+  int RunMainMessageLoop();
+
+ protected:
+  void NotifyUILoopOfPendingFunctions() override;
+  void PlatformQuitFromUIThread() override;
+
+ private:
+  std::mutex loop_mutex_;
+  std::condition_variable loop_cv_;
+};
+
+}  // namespace rex::ui
