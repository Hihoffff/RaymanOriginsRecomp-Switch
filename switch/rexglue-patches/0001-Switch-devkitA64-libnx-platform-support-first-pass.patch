diff --git a/include/rex/filesystem/devices/stfs_xbox.h b/include/rex/filesystem/devices/stfs_xbox.h
index 7d4e366..13af98c 100644
--- a/include/rex/filesystem/devices/stfs_xbox.h
+++ b/include/rex/filesystem/devices/stfs_xbox.h
@@ -42,6 +42,17 @@ inline uint64_t decode_fat_timestamp(const uint32_t date, const uint32_t time) {
 
 #if REX_PLATFORM_WIN32
   time_t timet = _mkgmtime(&tm);
+#elif REX_PLATFORM_SWITCH
+  // newlib has no timegm; convert broken-down UTC directly (days-from-civil).
+  const int64_t cy = tm.tm_year + 1900 - (tm.tm_mon + 1 <= 2);
+  const int64_t era = (cy >= 0 ? cy : cy - 399) / 400;
+  const uint32_t yoe = static_cast<uint32_t>(cy - era * 400);
+  const uint32_t mp = static_cast<uint32_t>((tm.tm_mon + 10) % 12);
+  const uint32_t doy = (153 * mp + 2) / 5 + static_cast<uint32_t>(tm.tm_mday) - 1;
+  const uint32_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  const int64_t days = era * 146097 + static_cast<int64_t>(doe) - 719468;
+  time_t timet = static_cast<time_t>(days * 86400 + tm.tm_hour * 3600 +
+                                     tm.tm_min * 60 + tm.tm_sec);
 #else
   time_t timet = timegm(&tm);
 #endif
