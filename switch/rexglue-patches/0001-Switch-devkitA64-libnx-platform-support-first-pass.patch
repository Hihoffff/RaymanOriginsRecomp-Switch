diff --git a/src/kernel/xam/xam_net_switch.cpp b/src/kernel/xam/xam_net_switch.cpp
new file mode 100644
index 0000000..d3e7846
--- /dev/null
+++ b/src/kernel/xam/xam_net_switch.cpp
@@ -0,0 +1,400 @@
+/**
+ * @file        kernel/xam/xam_net_switch.cpp
+ * @brief       Offline NetDll stub for Nintendo Switch (no BSD sockets in newlib)
+ *
+ * Rayman Origins is playable offline, so every NetDll_* import answers
+ * consistently as "no network". WSA events are real kernel events because the
+ * game waits on them. Semantics mirror the proven stub from the upstream
+ * switch branch (runtime/kernel/net_imports.cpp). A proper port would go
+ * through libnx's bsd service.
+ */
+
+// Disable warnings about unused parameters for kernel functions
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+
+#include <cstring>
+
+#include <rex/kernel/xam/module.h>
+#include <rex/kernel/xam/private.h>
+#include <rex/kernel/xboxkrnl/error.h>
+#include <rex/kernel/xboxkrnl/threading.h>
+#include <rex/logging.h>
+#include <rex/string.h>
+#include <rex/hook.h>
+#include <rex/types.h>
+#include <rex/system/kernel_state.h>
+
+namespace rex {
+namespace kernel {
+namespace xam {
+using namespace rex::system;
+using namespace rex::system::xam;
+
+// Guest-visible types from xam_net.cpp. Forward declarations suffice: the
+// stubs never dereference them.
+struct XNetStartupParams;
+struct X_WSADATA;
+struct XWSABUF;
+struct XSOCKADDR;
+struct XSOCKADDR_IN;
+struct XWSAOVERLAPPED;
+struct XNADDR;
+struct XNDNS;
+struct XNQOS;
+struct x_fd_set;
+
+constexpr uint32_t kSocketError = ~0u;
+constexpr uint32_t kInvalidSocket = ~0u;
+constexpr uint32_t kWSANetDown = 10050;
+constexpr uint32_t kWSAHostNotFound = 11001;
+constexpr uint32_t kXNetGetXnAddrNone = 0x00000001;
+
+static uint32_t NetFail(uint32_t error) {
+  XThread::SetLastError(error);
+  return kSocketError;
+}
+
+// --- Lifecycle: report success so the title believes XNet is up. ---
+
+u32 NetDll_XNetStartup_entry(u32 caller, ppc_ptr_t<XNetStartupParams> params) { return 0; }
+u32 NetDll_XNetCleanup_entry(u32 caller, mapped_void params) { return 0; }
+u32 NetDll_XNetGetOpt_entry(u32 one, u32 option_id, mapped_void buffer_ptr,
+                            mapped_u32 buffer_size) {
+  return kSocketError;
+}
+u32 NetDll_XNetRandom_entry(u32 caller, mapped_void buffer_ptr, u32 length) {
+  // Matches xam_net.cpp: constant values make replicating easier.
+  std::memset(buffer_ptr, 0xBB, length);
+  return 0;
+}
+u32 NetDll_WSAStartup_entry(u32 caller, u16 version, ppc_ptr_t<X_WSADATA> data_ptr) { return 0; }
+u32 NetDll_WSACleanup_entry(u32 caller) { return 0; }
+u32 NetDll_WSAGetLastError_entry() { return XThread::GetLastError(); }
+void NetDll_WSASetLastError_entry(u32 error_code) { XThread::SetLastError(error_code); }
+
+// --- WSA events: real kernel events, the game waits on them. ---
+
+u32 NetDll_WSAWaitForMultipleEvents_entry(u32 num_events, mapped_u32 events, u32 wait_all,
+                                          u32 timeout, u32 alertable) {
+  if (num_events > 64) {
+    XThread::SetLastError(87);  // ERROR_INVALID_PARAMETER
+    return ~0u;
+  }
+
+  uint64_t timeout_wait = (uint64_t)timeout;
+
+  X_STATUS result = 0;
+  do {
+    result = xboxkrnl::xeNtWaitForMultipleObjectsEx(num_events, events, wait_all, 1, alertable,
+                                                    timeout != -1 ? &timeout_wait : nullptr);
+  } while (result == X_STATUS_ALERTED);
+
+  if (XFAILED(result)) {
+    uint32_t error = xboxkrnl::xeRtlNtStatusToDosError(result);
+    XThread::SetLastError(error);
+    return ~0u;
+  }
+  return 0;
+}
+
+u32 NetDll_WSACreateEvent_entry() {
+  XEvent* ev = new XEvent(REX_KERNEL_STATE());
+  ev->Initialize(true, false);
+  return ev->handle();
+}
+
+u32 NetDll_WSACloseEvent_entry(u32 event_handle) {
+  X_STATUS result = REX_KERNEL_OBJECTS()->ReleaseHandle(event_handle);
+  if (XFAILED(result)) {
+    uint32_t error = xboxkrnl::xeRtlNtStatusToDosError(result);
+    XThread::SetLastError(error);
+    return 0;
+  }
+  return 1;
+}
+
+u32 NetDll_WSAResetEvent_entry(u32 event_handle) {
+  X_STATUS result = xboxkrnl::xeNtClearEvent(event_handle);
+  if (XFAILED(result)) {
+    uint32_t error = xboxkrnl::xeRtlNtStatusToDosError(result);
+    XThread::SetLastError(error);
+    return 0;
+  }
+  return 1;
+}
+
+u32 NetDll_WSASetEvent_entry(u32 event_handle) {
+  X_STATUS result = xboxkrnl::xeNtSetEvent(event_handle, nullptr);
+  if (XFAILED(result)) {
+    uint32_t error = xboxkrnl::xeRtlNtStatusToDosError(result);
+    XThread::SetLastError(error);
+    return 0;
+  }
+  return 1;
+}
+
+// --- Addressing: no interface, no online identity. ---
+
+u32 NetDll_XNetGetTitleXnAddr_entry(u32 caller, ppc_ptr_t<XNADDR> addr_ptr) {
