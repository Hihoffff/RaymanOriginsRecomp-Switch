+/**
+ * @file        ui/windowed_app_context_switch.cpp
+ * @brief       Nintendo Switch UI loop context
+ */
+
+#include <rex/ui/windowed_app_context_switch.h>
+
+#include <cstdlib>
+
+namespace rex::ui {
+
+SwitchWindowedAppContext::~SwitchWindowedAppContext() {
+  // Execute leftover pending functions before the loop machinery goes away,
+  // mirroring the shutdown contract documented in WindowedAppContext.
+  ExecutePendingFunctionsFromUIThread();
+}
+
+void SwitchWindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  loop_cv_.notify_one();
+}
+
+void SwitchWindowedAppContext::PlatformQuitFromUIThread() {
+  // The loop re-checks HasQuitFromUIThread after every wakeup; make sure one
+  // is delivered even if the pending queue was empty.
+  NotifyUILoopOfPendingFunctions();
+}
+
+int SwitchWindowedAppContext::RunMainMessageLoop() {
+  while (!HasQuitFromUIThread()) {
+    ExecutePendingFunctionsFromUIThread();
+    if (HasQuitFromUIThread()) {
+      break;
+    }
+    std::unique_lock<std::mutex> lock(loop_mutex_);
+    loop_cv_.wait_for(lock, std::chrono::milliseconds(50));
+  }
+  return EXIT_SUCCESS;
+}
+
+}  // namespace rex::ui
diff --git a/src/ui/windowed_app_main_switch.cpp b/src/ui/windowed_app_main_switch.cpp
new file mode 100644
index 0000000..cc4b6db
--- /dev/null
+++ b/src/ui/windowed_app_main_switch.cpp
@@ -0,0 +1,91 @@
+/**
+ * @file        ui/windowed_app_main_switch.cpp
+ * @brief       Entry point for windowed applications (Nintendo Switch/libnx)
+ *
+ * No SDL and no OS message loop on Horizon: stderr goes to a log on the SD
+ * card, game data defaults to sdmc:/switch/RaymanOriginsRecomp/game, and the
+ * UI loop is the condition-variable loop in SwitchWindowedAppContext.
+ */
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_switch.h>
+
+namespace {
+
+constexpr const char* kSdRoot = "sdmc:/switch/RaymanOriginsRecomp";
+constexpr const char* kLogPath = "sdmc:/switch/RaymanOriginsRecomp/rayman.log";
+
+int RunWindowedApp(int argc, char** argv) {
+  auto remaining = rex::cvar::Init(argc, argv);
+  rex::cvar::ApplyEnvironment();
+  rex::InitLoggingEarly();
+
+  int result;
+  {
+    rex::ui::SwitchWindowedAppContext app_context;
+    if (!app_context.Initialize()) {
+      return EXIT_FAILURE;
+    }
+
+    std::unique_ptr<rex::ui::WindowedApp> app = rex::ui::GetWindowedAppCreator()(app_context);
+
+    const auto& option_names = app->GetPositionalOptions();
+    std::map<std::string, std::string> parsed;
+    size_t count = std::min(remaining.size(), option_names.size());
+    for (size_t i = 0; i < count; ++i) {
+      parsed[option_names[i]] = remaining[i];
+    }
+    app->SetParsedArguments(std::move(parsed));
+
+    result = app->OnInitialize() ? app_context.RunMainMessageLoop() : EXIT_FAILURE;
+
+    app->InvokeOnDestroy();
+  }
+
+  return result;
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+  // No console on Horizon by default: route stderr to the SD card so crashes
+  // and [perf] lines are retrievable after the run.
+  std::string log_path = kLogPath;
+  for (int i = 1; i + 1 < argc; ++i) {
+    if (std::string_view(argv[i]) == "--log_file") {
+      log_path = argv[i + 1];
+    }
+  }
+  if (FILE* redirected = std::freopen(log_path.c_str(), "w", stderr)) {
+    setvbuf(redirected, nullptr, _IOLBF, BUFSIZ);
+  }
+
+  std::vector<std::string> args(argv, argv + argc);
+  auto has_arg = [&args](const char* name) {
+    return std::any_of(args.begin(), args.end(),
+                       [name](const std::string& a) { return a.rfind(name, 0) == 0; });
+  };
+  if (!has_arg("--game_data_root")) {
+    args.push_back(std::string("--game_data_root=") + kSdRoot + "/game");
+  }
+  if (!has_arg("--log_file")) {
+    args.push_back(std::string("--log_file=") + log_path);
+  }
+
+  std::vector<char*> argv_ptrs;
+  argv_ptrs.reserve(args.size());
+  for (auto& s : args) {
+    argv_ptrs.push_back(s.data());
+  }
+  return RunWindowedApp(static_cast<int>(argv_ptrs.size()), argv_ptrs.data());
+}
