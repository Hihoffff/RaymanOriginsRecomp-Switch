--- a/src/system/xmemory.cpp
+++ b/src/system/xmemory.cpp
@@ -157,6 +157,17 @@ bool Memory::Initialize() {
     return false;
   }
   mapping_base_ = views_.all_views[0];
+#elif REX_PLATFORM_SWITCH
+  // Horizon: the 4 GB guest window comes from libnx virtmem; views are not
+  // real aliases (see core/memory_switch.cpp).
+  {
+    uint8_t* window = rex::memory::SwitchReserveGuestWindow(0x100000000ull);
+    if (!window || MapViews(window)) {
+      REXSYS_ERROR("Unable to reserve the 4gb guest address space (Switch).");
+      return false;
+    }
+    mapping_base_ = window;
+  }
 #else
   // Attempt to create our views. This may fail at the first address
   // we pick, so try a few times.
@@ -175,7 +186,13 @@ bool Memory::Initialize() {
   }
 #endif
   virtual_membase_ = mapping_base_;
+#if REX_PLATFORM_SWITCH
+  // No real aliasing on Horizon: make the raw physical view coincide with the
+  // 64K-page physical view (0xA0000000), so host and guest see the same bytes.
+  physical_membase_ = mapping_base_ + 0xA0000000ull;
+#else
   physical_membase_ = mapping_base_ + 0x100000000ull;
+#endif
 
   REXSYS_INFO("Guest memory arena mapped: virtual base 0x{:016X}, physical base 0x{:016X}",
               reinterpret_cast<uintptr_t>(virtual_membase_),
