From 1862c2d510d22b9e0a47b01d57bc390799305f49 Mon Sep 17 00:00:00 2001
From: hihoffff <hihoffff@example.invalid>
Date: Mon, 9 Nov 2026 17:09:19 +0300
Subject: [PATCH] Switch: enable POSIX-neutral core sources, seh stub, clock
 fix

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/core/CMakeLists.txt             | 14 +++++++++
 src/core/atomic_posix.cpp           |  2 +-
 src/core/clock_posix.cpp            | 15 +++++++---
 src/core/filesystem_posix.cpp       |  2 +-
 src/core/platform/console_posix.cpp |  2 +-
 src/core/platform/env_posix.cpp     |  2 +-
 src/core/seh_posix.cpp              |  2 +-
 src/core/seh_switch.cpp             | 45 +++++++++++++++++++++++++++++
 8 files changed, 75 insertions(+), 9 deletions(-)
 create mode 100644 src/core/seh_switch.cpp

diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index e6a9c84..409ec88 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -53,6 +53,20 @@ if(WIN32)
         threading_win.cpp
     )
     target_compile_definitions(rexcore PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
+elseif(CMAKE_SYSTEM_NAME STREQUAL "NintendoSwitch")
+    # Horizon/libnx (newlib): no mmap, dlopen, signals or Linux syscalls.
+    # *_switch.cpp files are the Switch backends; the rest are POSIX-neutral.
+    target_sources(rexcore PRIVATE
+        atomic_posix.cpp
+        clock_posix.cpp
+        dbg_posix.cpp
+        filesystem_posix.cpp
+        math_gcc.cpp
+        platform/console_posix.cpp
+        platform/env_posix.cpp
+        seh_switch.cpp
+        system_posix.cpp
+    )
 elseif(UNIX)
     # Linux and macOS/Darwin share the POSIX sources; Darwin-specific behavior
     # is selected inside them with #if defined(__APPLE__).
diff --git a/src/core/atomic_posix.cpp b/src/core/atomic_posix.cpp
index 378aa4b..62ed779 100644
--- a/src/core/atomic_posix.cpp
+++ b/src/core/atomic_posix.cpp
@@ -1,7 +1,7 @@
 #include <rex/platform.h>
 #include <rex/thread/atomic.h>
 
-static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
+static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC || REX_PLATFORM_SWITCH, "This file is POSIX-only");
 
 namespace rex::thread {
 
diff --git a/src/core/clock_posix.cpp b/src/core/clock_posix.cpp
index 00f2382..0cffab3 100644
--- a/src/core/clock_posix.cpp
+++ b/src/core/clock_posix.cpp
@@ -10,7 +10,14 @@
 #include <rex/chrono/clock.h>
 #include <rex/platform.h>
 
-static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
+static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC || REX_PLATFORM_SWITCH, "This file is POSIX-only");
+
+// newlib/Horizon has no CLOCK_MONOTONIC_RAW.
+#if REX_PLATFORM_SWITCH
+#define REX_CLOCK_MONOTONIC_RAW CLOCK_MONOTONIC
+#else
+#define REX_CLOCK_MONOTONIC_RAW CLOCK_MONOTONIC_RAW
+#endif
 
 #include <sys/time.h>
 
@@ -27,7 +34,7 @@ uint64_t Clock::host_tick_frequency_platform() {
   return (uint64_t)((1000000000ull * (uint64_t)info.denom) / (uint64_t)info.numer);
 #else
   timespec res;
-  int error = clock_getres(CLOCK_MONOTONIC_RAW, &res);
+  int error = clock_getres(REX_CLOCK_MONOTONIC_RAW, &res);
   assert_zero(error);
   assert_zero(res.tv_sec);  // Sub second resolution is required.
 
@@ -40,12 +47,12 @@ uint64_t Clock::host_tick_count_platform() {
 #ifdef __APPLE__
   // mach_absolute_time() returns raw hardware ticks; host_tick_frequency_platform()
   // expresses the rate of these same ticks via mach_timebase_info.
-  // clock_gettime(CLOCK_MONOTONIC_RAW) returns nanoseconds, which would be
+  // clock_gettime(REX_CLOCK_MONOTONIC_RAW) returns nanoseconds, which would be
   // inconsistent with the 24 MHz mach frequency and cause ~41x time acceleration.
   return mach_absolute_time();
 #else
   timespec tp;
-  int error = clock_gettime(CLOCK_MONOTONIC_RAW, &tp);
+  int error = clock_gettime(REX_CLOCK_MONOTONIC_RAW, &tp);
   assert_zero(error);
 
   return tp.tv_nsec + tp.tv_sec * 1000000000ull;
diff --git a/src/core/filesystem_posix.cpp b/src/core/filesystem_posix.cpp
index 1383024..765d487 100644
--- a/src/core/filesystem_posix.cpp
+++ b/src/core/filesystem_posix.cpp
@@ -40,7 +40,7 @@
 
 // macOS off_t is 64-bit with no *64 large-file variants; Linux keeps the
 // explicit *64 forms for legacy 32-bit off_t distributions.
-#if defined(__APPLE__)
+#if defined(__APPLE__) || defined(__SWITCH__)
 using rex_off64_t = off_t;
 #define rex_fseeko64 fseeko
 #define rex_ftello64 ftello
diff --git a/src/core/platform/console_posix.cpp b/src/core/platform/console_posix.cpp
index 669842b..1f8728a 100644
--- a/src/core/platform/console_posix.cpp
+++ b/src/core/platform/console_posix.cpp
@@ -12,7 +12,7 @@
 #include <rex/platform.h>
 #include <rex/platform/console.h>
 
-static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
+static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC || REX_PLATFORM_SWITCH, "This file is POSIX-only");
 
 #include <unistd.h>
 
diff --git a/src/core/platform/env_posix.cpp b/src/core/platform/env_posix.cpp
index fb794b2..df1aa60 100644
--- a/src/core/platform/env_posix.cpp
+++ b/src/core/platform/env_posix.cpp
@@ -12,7 +12,7 @@
 #include <rex/platform.h>
 #include <rex/platform/env.h>
 
-static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
+static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC || REX_PLATFORM_SWITCH, "This file is POSIX-only");
 
 #include <cstdlib>
 #include <string>
diff --git a/src/core/seh_posix.cpp b/src/core/seh_posix.cpp
index 5e0a932..c02c079 100644
--- a/src/core/seh_posix.cpp
+++ b/src/core/seh_posix.cpp
@@ -9,7 +9,7 @@
 #include <rex/platform.h>
 #include <rex/platform/seh.h>
 
-static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
+static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC || REX_PLATFORM_SWITCH, "This file is POSIX-only");
 
 #include <signal.h>
 #include <cstdlib>  // std::abort()
diff --git a/src/core/seh_switch.cpp b/src/core/seh_switch.cpp
new file mode 100644
index 0000000..2f940fa
--- /dev/null
+++ b/src/core/seh_switch.cpp
@@ -0,0 +1,45 @@
+/**
+ * @file        core/seh_switch.cpp
+ * @brief       Nintendo Switch (Horizon) SEH stubs
+ *
+ * Horizon has no POSIX signals, so hardware faults cannot be turned into
+ * C++ exceptions here. Faults are reported by the libnx exception handler
+ * (see exception_handler_switch.cpp, TODO) and terminate the process.
+ * Same interface as seh_posix.cpp so guest __try/__except code links.
+ */
+
+#include <rex/platform.h>
+#include <rex/platform/seh.h>
+
+static_assert(REX_PLATFORM_SWITCH, "This file is Nintendo Switch-only");
+
+#include <cstdlib>
+
+#include <rex/platform/exceptions.h>
+
+namespace rex::platform {
+
+static thread_local SehThreadState tls_seh_state;
+static thread_local bool tls_seh_active = false;
+
+SehThreadState& seh_thread_state() {
+  return tls_seh_state;
+}
+
+int seh_filter(uint32_t /*code*/, void* /*ep*/) {
+  return 0;
+}
+
+[[noreturn]] void seh_rethrow() {
+  abort();
+}
+
+void seh_initialize() {
+  g_seh_initialized.exchange(true);
+}
+
+bool& seh_active() {
+  return tls_seh_active;
+}
+
+}  // namespace rex::platform
