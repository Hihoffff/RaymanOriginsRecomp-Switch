-BUILD=$R/out/build/mac-arm64-release
+BUILD=${BUILD:-$R/out/build/mac-arm64-release}
 
 for lib in libvulkan.1.dylib libMoltenVK.dylib; do
     [ -f "$BUILD/$lib" ] || cp "$SDK/lib/$lib" "$BUILD/"
@@ -23,7 +23,7 @@ if [ ! -f "$BUILD/librexgpu-null.dylib" ]; then
 fi
 
 cd "$R"
-export VK_DRIVER_FILES="$SDK/share/vulkan/icd.d/MoltenVK_icd.json"
+export VK_DRIVER_FILES="$P/tools/moltenvk/MoltenVK/MoltenVK/dynamic/dylib/macOS/MoltenVK_icd.json"
