+// Bytes DecodeTextureTo writes. With keep_blocks, DXT stays compressed: the
+// untiled, endian-swapped 4x4 blocks are the standard BC1/BC2/BC3 layout.
+inline size_t UploadSize(const TextureFetch& t, bool keep_blocks) {
+  if (keep_blocks && IsBlockFormat(t.format)) {
+    return size_t((t.width + 3) / 4) * ((t.height + 3) / 4) * (t.format == 0x12 ? 8 : 16);
+  }
+  return DecodedSize(t);
