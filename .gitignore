tools/llvm/
tools/rexglue/
tools/XenonRecomp/

__pycache__/

# клон upstream (не вендорим в наш git)
upstream/

# NVK-пакет для Switch (результат внешней сборки mesa-switch, не коммитим)
switch/nvk-switch/
